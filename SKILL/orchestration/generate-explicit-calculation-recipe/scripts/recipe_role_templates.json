{
  "artifact_import": {
    "title": "Import required prior artifacts",
    "prior": ["source_artifact_locations"],
    "inputs": ["artifact_selection"],
    "operations": ["resolve_source_artifacts", "copy_or_link_artifacts", "write_import_manifest"],
    "method": ["artifact_provenance_import"],
    "outputs": ["import_manifest.json"]
  },
  "structure_model_build": {
    "title": "Build structure model",
    "prior": ["source_structure_or_construction_specification"],
    "inputs": ["model_definition", "cell_and_boundary_policy"],
    "operations": ["construct_structure_model", "write_structure_file", "write_model_metadata"],
    "method": ["atomistic_model_construction"],
    "outputs": ["structure_model", "model_metadata.json"]
  },
  "adsorbate_structure_build": {
    "title": "Build adsorbate or intermediate structures",
    "prior": ["clean_structure_files", "placement_or_state_specification"],
    "inputs": ["adsorbate_or_intermediate_definitions", "site_definitions"],
    "operations": ["construct_requested_states", "write_structure_files", "write_state_registry"],
    "method": ["adsorbate_or_intermediate_model_construction"],
    "outputs": ["state_structure_files", "state_registry.json"]
  },
  "clean_structure_relaxation": {
    "title": "Relax clean structure set",
    "prior": ["clean_structure_files", "shared_relaxation_settings"],
    "inputs": ["clean_model_matrix"],
    "operations": ["prepare_relaxation_inputs", "relax_clean_structures", "record_relaxation_outputs"],
    "method": ["geometry_optimization"],
    "outputs": ["relaxed_clean_structures", "clean_relaxation_registry.json"]
  },
  "adsorbate_relaxation_matrix": {
    "title": "Relax adsorbate or intermediate state matrix",
    "prior": ["state_structure_files", "shared_relaxation_settings"],
    "inputs": ["state_matrix"],
    "operations": ["prepare_relaxation_inputs", "relax_state_structures", "record_relaxation_outputs"],
    "method": ["state_geometry_optimization"],
    "outputs": ["relaxed_state_structures", "state_relaxation_registry.json"]
  },
  "single_point_energy_calculation": {
    "title": "Calculate single-point energies",
    "prior": ["input_structures", "energy_method_settings"],
    "inputs": ["structure_matrix"],
    "operations": ["prepare_single_point_inputs", "calculate_energies", "write_energy_registry"],
    "method": ["single_point_energy_calculation"],
    "outputs": ["energy_registry.json", "energy_table.csv"]
  },
  "vibrational_analysis": {
    "title": "Calculate vibrational properties",
    "prior": ["relaxed_structures", "vibrational_method_settings"],
    "inputs": ["vibrational_target_selection"],
    "operations": ["calculate_vibrational_modes", "write_frequency_records", "write_thermal_corrections"],
    "method": ["vibrational_frequency_analysis"],
    "outputs": ["vibrational_frequencies.json", "thermal_corrections.json"]
  },
  "reaction_pathway_search": {
    "title": "Search reaction pathway or transition state",
    "prior": ["endpoint_structures", "pathway_method_settings"],
    "inputs": ["initial_and_final_states", "reaction_coordinate_definition"],
    "operations": ["prepare_pathway_images", "search_reaction_pathway", "write_barrier_records"],
    "method": ["reaction_pathway_or_transition_state_search"],
    "outputs": ["reaction_pathway.json", "barrier_summary.json"]
  },
  "molecular_dynamics": {
    "title": "Run molecular dynamics",
    "prior": ["initial_structures", "dynamics_settings"],
    "inputs": ["ensemble_and_trajectory_specification"],
    "operations": ["prepare_dynamics_inputs", "run_dynamics", "analyze_trajectory"],
    "method": ["molecular_dynamics"],
    "outputs": ["trajectory", "dynamics_summary.json"]
  },
  "solvation_analysis": {
    "title": "Evaluate solvation effects",
    "prior": ["structures_or_energy_records", "solvation_specification"],
    "inputs": ["solvent_model_and_state_matrix"],
    "operations": ["apply_solvation_model", "compare_solvated_states", "write_solvation_records"],
    "method": ["solvation_analysis"],
    "outputs": ["solvation_results.json", "solvation_comparison.csv"]
  },
  "free_energy_state_definition": {
    "title": "Define free-energy state",
    "prior": ["state_structures_or_reference_species", "reference_policy"],
    "inputs": ["state_definition"],
    "operations": ["map_state_components", "map_reference_terms", "write_state_definition"],
    "method": ["free_energy_state_definition"],
    "outputs": ["state_definition.json"]
  },
  "free_energy_diagram_assembly": {
    "title": "Assemble free-energy diagram",
    "prior": ["state_energy_records", "reference_energy_records", "thermal_corrections_if_requested"],
    "inputs": ["ordered_state_definitions"],
    "operations": ["assemble_state_table", "compute_relative_free_energies", "write_diagram_inputs"],
    "method": ["free_energy_diagram_construction"],
    "outputs": ["free_energy_state_table.json", "free_energy_diagram_inputs.csv"]
  },
  "electrochemical_free_energy_bookkeeping": {
    "title": "Perform electrochemical free-energy bookkeeping",
    "prior": ["state_energy_records", "electrochemical_reference_policy"],
    "inputs": ["source_defined_electrochemical_conditions"],
    "operations": ["apply_source_defined_reference_terms", "compute_relative_free_energies", "write_conditioned_energy_table"],
    "method": ["electrochemical_free_energy_bookkeeping"],
    "outputs": ["electrochemical_free_energies.json", "electrochemical_free_energies.csv"]
  },
  "potential_shift_analysis": {
    "title": "Evaluate potential dependence",
    "prior": ["electrochemical_free_energy_records"],
    "inputs": ["source_defined_potential_values", "electron_transfer_definitions"],
    "operations": ["apply_potential_dependence", "compare_conditioned_profiles", "write_potential_series"],
    "method": ["potential_dependent_analysis"],
    "outputs": ["potential_dependent_results.json"]
  },
  "descriptor_calculation": {
    "title": "Calculate or compare descriptors",
    "prior": ["calculation_result_records"],
    "inputs": ["descriptor_definitions", "comparison_index"],
    "operations": ["calculate_requested_descriptors", "compare_requested_cases", "write_descriptor_table"],
    "method": ["descriptor_analysis"],
    "outputs": ["descriptor_table.csv", "descriptor_summary.json"]
  },
  "density_of_states_analysis": {
    "title": "Calculate density of states",
    "prior": ["relaxed_structures", "electronic_structure_settings"],
    "inputs": ["electronic_structure_targets"],
    "operations": ["calculate_density_of_states", "write_dos_table"],
    "method": ["density_of_states_analysis"],
    "outputs": ["density_of_states.csv", "density_of_states_summary.json"]
  },
  "projected_dos_analysis": {
    "title": "Calculate projected density of states",
    "prior": ["relaxed_structures", "wavefunction_or_projector_data"],
    "inputs": ["projection_targets"],
    "operations": ["calculate_projected_dos", "write_projected_dos_tables"],
    "method": ["projected_density_of_states_analysis"],
    "outputs": ["projected_dos.csv", "projected_dos_summary.json"]
  },
  "charge_transfer_analysis": {
    "title": "Calculate charge-transfer properties",
    "prior": ["relaxed_structures", "electronic_density_data"],
    "inputs": ["charge_analysis_targets"],
    "operations": ["calculate_charge_descriptors", "compare_requested_states", "write_charge_table"],
    "method": ["charge_transfer_analysis"],
    "outputs": ["charge_transfer.csv", "charge_transfer_summary.json"]
  },
  "stability_analysis": {
    "title": "Evaluate structural or thermodynamic stability",
    "prior": ["structure_or_energy_records"],
    "inputs": ["stability_criteria"],
    "operations": ["evaluate_requested_stability_metrics", "compare_candidate_states", "write_stability_summary"],
    "method": ["stability_analysis"],
    "outputs": ["stability_results.json", "stability_comparison.csv"]
  },
  "benchmark_constraint_comparison": {
    "title": "Compare calculations with benchmark constraints",
    "prior": ["calculation_result_records", "benchmark_constraint_records"],
    "inputs": ["source_defined_benchmarks"],
    "operations": ["compare_results_to_benchmarks", "write_bounded_comparison"],
    "method": ["benchmark_constraint_comparison"],
    "outputs": ["benchmark_comparison.json", "benchmark_comparison.md"]
  }
}
