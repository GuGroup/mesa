# Copy this file to .env at the repository root or export these variables in
# your shell. Never commit a filled .env file.
#
# Load locally with:
#   set -a
#   source .env
#   set +a

# ---------------------------------------------------------------------------
# Core MESA keys
# ---------------------------------------------------------------------------
# Required for OpenAI-backed PDF extraction and strategy-generation skills:
OPENAI_API_KEY=

# Optional model override for OpenAI-backed lightweight skills:
OPENAI_MODEL=

# Required only when fetching bulk structures from Materials Project:
MP_API_KEY=
# Legacy/alternate Materials Project variable also supported:
PMG_MAPI_KEY=

# ---------------------------------------------------------------------------
# Local SearchAgent / mesa-paper-search
# ---------------------------------------------------------------------------
# Deterministic mode needs no LLM key. Full mode can use OPENAI_API_KEY,
# ANTHROPIC_API_KEY, or openai-oauth.
PAPER_SEARCH_PROVIDER=
PAPER_SEARCH_MODEL=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# Optional PaperQA OpenAI embedding key. Leave unset when using local embeddings.
OPENAI_EMBEDDING_KEY=

# Optional search/full-text provider improvements:
PAPER_SEARCH_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
PAPER_SEARCH_GROBID_URL=
PAPER_SEARCH_GROBID_START_CMD=
PAPER_SEARCH_OPENDATALOADER_CMD=

# ---------------------------------------------------------------------------
# External paper-search-mcp
# ---------------------------------------------------------------------------
# Required only for Unpaywall lookup in paper-search-mcp:
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=

# Better rate limits / coverage:
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_MCP_DOAJ_API_KEY=
PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN=
PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL=

# Optional source-specific keys:
PAPER_SEARCH_MCP_OPENAIRE_API_KEY=
PAPER_SEARCH_MCP_CITESEERX_API_KEY=

# Required only to activate these paid/specialized MCP connectors:
PAPER_SEARCH_MCP_IEEE_API_KEY=
PAPER_SEARCH_MCP_ACM_API_KEY=

