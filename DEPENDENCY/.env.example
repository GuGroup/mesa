# Copy this file to DEPENDENCY/.env or export these variables in your shell.
# Never commit a filled .env file.
#
# Load locally with:
#   set -a
#   source DEPENDENCY/.env
#   set +a

# ---------------------------------------------------------------------------
# Core MESA keys
# ---------------------------------------------------------------------------
# Required for tools that call the OpenAI API directly:
# Create/manage keys: https://platform.openai.com/api-keys
# Help: https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key
# Save the key when it is created; the full secret is shown only once.
OPENAI_API_KEY=

# Optional model override for OpenAI-backed lightweight skills:
OPENAI_MODEL=

# Required only when fetching bulk structures from Materials Project:
# Get your key: https://next-gen.materialsproject.org/api
# Docs: https://docs.materialsproject.org/downloading-data/using-the-api/getting-started
MP_API_KEY=
# Legacy/alternate Materials Project variable also supported:
PMG_MAPI_KEY=

# ---------------------------------------------------------------------------
# Optional Hugging Face checkpoint access/cache
# ---------------------------------------------------------------------------
# Required only for gated/private Hugging Face checkpoint downloads.
# Public checkpoints or already-local checkpoint files may not need this.
# Create/manage tokens: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional cache/token location for Hugging Face downloads.
# Leave unset to use the default ~/.cache/huggingface location.
HF_HOME=
